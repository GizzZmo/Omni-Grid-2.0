{
  "name": "omni-grid-2.0",
  "private": true,
  "version": "2.5.7",
  "type": "module",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:server": "make server",
    "build:all": "npm run build && npm run build:server",
    "build:analyze": "vite build && node scripts/measure-bundle.mjs",
    "serve": "./omnigrid_server",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "measure:bundle": "node scripts/measure-bundle.mjs",
    "assets:generate": "node scripts/generate-screenshot-assets.mjs",
    "artifacts:generate": "node scripts/generate-build-artifacts.mjs",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,json,css,scss,md,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@google/genai": "^2.21.0",
    "@monaco-editor/react": "^4.7.0",
    "@testing-library/dom": "^10.4.1",
    "lucide-react": "1.41.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-grid-layout": "2.2.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-grid-layout": "^2.1.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "brace-expansion": "1.1.18",
    "flatted": "3.4.2",
    "dompurify": "3.4.13",
    "postcss": "8.5.25",
    "protobufjs": "7.6.5",
    "ws": "8.21.0",
    "js-yaml": "4.3.1"
  }
}
